%%
function loss = opt_fun(p, all_data, i)
    
    g = p(1);
    tau = p(2);

    y = expt_filt(all_data,i,g,tau);

    bump = mod(interp1(all_data(i).ft.xb,unwrap(all_data(i).im.mu),all_data(i).ft.xf),2*pi);
    rho  = interp1(all_data(i).ft.xb,all_data(i).im.rho,all_data(i).ft.xf);
    y    = mod(y,2*pi);
    idx = ~isnan(bump) & ~isnan(y) & rho >.4;
    loss = circ_var(circ_dist(y(idx),bump(idx)));
    if sum(idx)==0
        loss = 2;
    end
end

function y = expt_filt(all_data,i,g,tau)

    dt = mean(diff(all_data(i).ft.xf));
    alpha = dt / (tau+dt);

    x = cumsum(all_data(i).ft.r_speed * g) * dt; %this is bump prime, the "perfect" bump with some gain
    
    y = zeros(size(x));
    y(1) = x(1);
    
    for t = 2:length(x) %implement exponential filter of time series
        y(t) = alpha * x(t) + (1-alpha) * y(t-1);
    end
end